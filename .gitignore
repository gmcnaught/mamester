# Build output
/build/
/_Other/
*.rbf
*.rbf.*

# ARM binaries / objects
*.o
*.a
*.so
*.so.*
*.armhf
*.elf

# ROMs and copyrighted content — NEVER commit
*.zip
*.7z
/roms/
/games/*/roms/

# Quartus
/fpga/db/
/fpga/incremental_db/
/fpga/output_files/
/fpga/simulation/
/fpga/greybox_tmp/
/fpga/*.qws
/fpga/*.rpt
/fpga/*.summary
/fpga/*.smsg

# Editor / OS
.DS_Store
*.swp
.vscode/
.idea/
compile_commands.json
/.ccls-cache/

# Sim artifacts
*.vcd
*.fst
*.vvp
tools/mister/test_frame_writer

# Claude Code worktrees
/.claude/worktrees/

# Serena MCP index cache
/.serena/

# Local build of the DDR write microbenchmark (tools/mister/ddr-write-bench.c)
tools/mister/ddr-write-bench

# Out-of-tree kernel module build output (tools/mister/mem_wc/). A local build
# lands here and is NOT committed; the shipped objects live in
# tools/mister/mem_wc/prebuilt/, one per kernel release, and these patterns are
# directory-local so they do not reach them.
tools/mister/mem_wc/*.ko
tools/mister/mem_wc/*.mod
tools/mister/mem_wc/*.mod.c
tools/mister/mem_wc/.*.cmd
tools/mister/mem_wc/Module.symvers
tools/mister/mem_wc/modules.order

# libretro host binary and its libretro-common objects (both are build output;
# *.o already covers lrc/, this catches the extensionless ELF)
tools/mame-frontend/libretro-host/mame2003
tools/mame-frontend/libretro-host/lrc/

# A/B host binaries built against a non-default archive (mame2003-o2, -o3)
tools/mame-frontend/libretro-host/mame2003-*

# Host-native test binary (tests/Makefile builds it; it is macOS-native, not armhf)
tests/nv_present_test
tests/nv_present_test.dSYM/
