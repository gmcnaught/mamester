diff --git a/src/rpi/sound.cpp b/src/rpi/sound.cpp
index 7b74942..f538b37 100644
--- a/src/rpi/sound.cpp
+++ b/src/rpi/sound.cpp
@@ -100,11 +100,16 @@ int osd_start_audio_stream(int stereo)
 	}
 
 	//Sound switched off?
-	if (Machine->sample_rate == 0) return samples_per_frame;
+	if (Machine->sample_rate == 0) {
+		fprintf(stderr, "mister_sound: sound disabled (sample_rate 0)\n");
+		return samples_per_frame;
+	}
 
 	// attempt to initialize SDL
 	// alsa_init will also ammend the samples_per_frame
 	g_alsa = alsa_init();
+	if (!g_alsa)
+		fprintf(stderr, "mister_sound: ALSA init failed -- running silent\n");
 
 	return samples_per_frame;
 }
@@ -256,9 +261,13 @@ void osd_sound_enable(int enable_it)
 {
 }
 
-#define TRY_ALSA(x) if (x < 0) { \
-goto error; \
-}
+// MiSTer: report which call failed. A silent goto here is how a failed
+// alsa_init() surfaced as a segfault: the caller stored NULL in g_alsa and
+// alsa_write() dereferenced it on the first frame of sound.
+#define TRY_ALSA(x) { int _mister_e = (x); if (_mister_e < 0) { \
+	fprintf(stderr, "mister_sound: %s failed: %s\n", #x, snd_strerror(_mister_e)); \
+	goto error; \
+} }
 
 static alsa_t *alsa_init(void)
 {
@@ -280,14 +289,45 @@ static alsa_t *alsa_init(void)
 
 	TRY_ALSA(snd_pcm_hw_params_malloc(&params));
 
-	//latency is one frame times by a multiplier (higher improves crackling?)
-	TRY_ALSA(snd_pcm_set_params(alsa->pcm,
-								SND_PCM_FORMAT_S16,
-								SND_PCM_ACCESS_RW_INTERLEAVED,
-								stream_cache_channels,
-								Machine->sample_rate,
-								0,
-								((float)TICKS_PER_SEC / (float)Machine->drv->frames_per_second) * 4)) ;
+	// MiSTer: the default PCM is plug -> rate -> file(/dev/MrAudio) -> hw:0, and
+	// snd_pcm_set_params' latency-derived buffer is rejected by that chain for
+	// many (rate, refresh) pairs -- including 44100 at 60 Hz, the common case,
+	// which fails with "Unable to get period size". Which values fail is
+	// rate-dependent and scattered (48000 also rejects 69639/73126/92879 us).
+	// The very same configuration requested explicitly is accepted, so ask for
+	// it that way: one period per emulated frame (sample_rate / refresh), four
+	// of them -- which is what the latency form was trying to express.
+	//
+	// The period has to stay equal to MAME's samples-per-frame, because the
+	// code below feeds period_size_frames back into samples_per_frame; an
+	// unrelated period (512 was tried) makes the sound engine produce the wrong
+	// number of samples per frame and the mixer then crashes.
+	//
+	// Resampling is enabled because the MiSTer chain is fixed at 48 kHz while
+	// mame4all clamps its own rate to 44100.
+	{
+		unsigned int      rate    = Machine->sample_rate;
+		double            fps     = Machine->drv->frames_per_second;
+		unsigned int      periods = 4;
+		snd_pcm_uframes_t period  =
+			(snd_pcm_uframes_t)((double)rate / (fps > 1.0 ? fps : 60.0) + 0.5);
+
+		if (period < 64) period = 64;
+
+		fprintf(stderr, "mister_sound: opening ALSA %d ch @ %u Hz, %.2f fps, "
+		        "period %lu x%u\n", stream_cache_channels, rate, fps,
+		        (unsigned long)period, periods);
+
+		TRY_ALSA(snd_pcm_hw_params_any(alsa->pcm, params));
+		TRY_ALSA(snd_pcm_hw_params_set_access(alsa->pcm, params, SND_PCM_ACCESS_RW_INTERLEAVED));
+		TRY_ALSA(snd_pcm_hw_params_set_format(alsa->pcm, params, SND_PCM_FORMAT_S16));
+		TRY_ALSA(snd_pcm_hw_params_set_channels(alsa->pcm, params, stream_cache_channels));
+		TRY_ALSA(snd_pcm_hw_params_set_rate_resample(alsa->pcm, params, 1));
+		TRY_ALSA(snd_pcm_hw_params_set_rate_near(alsa->pcm, params, &rate, 0));
+		TRY_ALSA(snd_pcm_hw_params_set_period_size_near(alsa->pcm, params, &period, 0));
+		TRY_ALSA(snd_pcm_hw_params_set_periods_near(alsa->pcm, params, &periods, 0));
+		TRY_ALSA(snd_pcm_hw_params(alsa->pcm, params));
+	}
 
 	TRY_ALSA(snd_pcm_get_params ( alsa->pcm, &buffer_size_frames, &alsa->period_size_frames ));
 
@@ -297,6 +337,8 @@ static alsa_t *alsa_init(void)
 
 	logerror("ALSA: Period size: %d frames\n", (int)alsa->period_size_frames);
 	logerror("ALSA: Buffer size: %d frames\n", (int)buffer_size_frames);
+	fprintf(stderr, "mister_sound: ALSA ready, period %d frames, buffer %d frames\n",
+	        (int)alsa->period_size_frames, (int)buffer_size_frames);
 
 	alsa->buffer_size_bytes = snd_pcm_frames_to_bytes(alsa->pcm, buffer_size_frames);
 	alsa->period_size_bytes = snd_pcm_frames_to_bytes(alsa->pcm, alsa->period_size_frames);
