 //  renderer_retro::draw
 //============================================================
@@ -73,11 +187,42 @@ int renderer_retro::draw(const int update)
 
 	m_bmdata = (uint8_t *)retro_get_fb_ptr();
 
-	//FIXME retro handle 16/32 bits
+	// MAMESTER: this was the FIXME "retro handle 16/32 bits", and it was a real
+	// bug rather than a missing feature. M16B makes libretro.cpp declare
+	// videoBuffer as uint16_t and report RETRO_PIXEL_FORMAT_RGB565 (:64-70,
+	// :774), but the instantiation below was unconditionally 32-bit -- so the
+	// renderer wrote 4-byte pixels, with a pitch counted in uint32_t units,
+	// into a buffer the frontend then read as 2-byte RGB565. A 2:1 stride
+	// mismatch, which shows up as a skewed, wrongly-coloured picture rather
+	// than as anything that fails.
+	//
+	// The pitch argument is in PixelType units and the buffer is `width`
+	// pixels wide either way, so only the instantiation changes.
+	// <uint16_t, 3,2,3, 11,5,0> is MAME's own RGB565 form (drawsdl.cpp:446).
 
 	// draw the primitives to the bitmap
 	window().m_primlist->acquire_lock();
-	software_renderer<uint32_t, 0,0,0, 16,8,0>::draw_primitives(*window().m_primlist, m_bmdata, width, height, width);
+#ifdef M16B
+	software_renderer<uint16_t, 3,2,3, 11,5,0>::draw_primitives(*window().m_primlist, m_bmdata, width, height, width);
+#else
+	if (!mamester_try_direct_blit(*window().m_primlist, m_bmdata, width, height, width))
+		software_renderer<uint32_t, 0,0,0, 16,8,0>::draw_primitives(*window().m_primlist, m_bmdata, width, height, width);
+	else
+		mamester_blit_direct++;
+	// Report an AGGREGATE, and not before the game is actually drawing. The
+	// first frames are MAME's own startup UI, where the fast path cannot apply
+	// and a verdict taken there is simply wrong -- which is exactly the mistake
+	// the first version of this made. Report the miss as loudly as the hit: a
+	// predicate that silently never matches looks like a lever that did nothing.
+	if (!mamester_blit_reported && mamester_blit_calls == 300)
+	{
+		mamester_blit_reported = true;
+		fprintf(stderr, "MISTER-HOST: render fast path %lu/%lu frames (%ux%u)%s\n",
+				mamester_blit_direct, mamester_blit_calls, width, height,
+				mamester_blit_direct ? "" : " -- always draw_primitives; "
+						"set MAMESTER_BLIT_DEBUG=<frame> to dump the primitive list");
+	}
+#endif
 	window().m_primlist->release_lock();
 
 	return 0;
